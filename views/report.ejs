<%- include('partials/header') %>

<main>

<div class="container-fluid mt-3">

    <div class="row">

        <!-- PANEL LỌC (ẩn khi in) -->
        <div class="col-lg-3 no-print">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <strong>BỘ LỌC BÁO CÁO</strong>
                </div>

                <div class="card-body">

                    <label class="form-label">Ký hiệu mẫu</label>
                    <select id="maMau" class="form-select mb-3">
                        <option value="all">Tất cả điểm</option>
                    </select>

                    <label class="form-label">Đợt quan trắc</label>
                    <select id="dot" class="form-select mb-3">
                        <option value="all">Tất cả đợt</option>
                        <option value="1">Đợt 1 (Tháng 4/2024)</option>
                        <option value="2">Đợt 2 (Tháng 7/2024)</option>
                        <option value="3">Đợt 3 (Tháng 10/2024)</option>
                    </select>

                    <label class="form-label">Từ ngày</label>
                    <input type="date" id="tuNgay" class="form-control mb-3">

                    <label class="form-label">Đến ngày</label>
                    <input type="date" id="denNgay" class="form-control mb-3">

                    <div class="d-grid gap-2 mb-3">
                        <button class="btn btn-primary" id="btnLoc">Lọc dữ liệu</button>
                        <button class="btn btn-outline-secondary" id="btnResetReport">Đặt lại bộ lọc</button>
                    </div>

                    <hr>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success" id="btnExportExcel">
                            Xuất bảng Excel
                        </button>
                        <button class="btn btn-outline-dark" id="btnPrint">
                            In báo cáo
                        </button>
                    </div>

                </div>

            </div>

        </div>

        <!-- NỘI DUNG BÁO CÁO -->
        <div class="col-lg-9">

            <div id="reportPrintArea">

                <h5 class="mb-1" id="reportTitle">BÁO CÁO TỔNG HỢP CHẤT LƯỢNG NƯỚC MẶT — TẤT CẢ CÁC ĐỢT</h5>
                <p class="text-muted mb-1">Tỉnh Quảng Ngãi</p>

                <div class="mb-3" style="font-size:14px;">
                    <div><b>Đơn vị lập báo cáo:</b> Sở Tài nguyên và Môi trường tỉnh Quảng Ngãi</div>
                    <div><b>Người lập:</b> <span id="reportAuthor">Quản trị viên hệ thống</span></div>
                    <div><b>Ngày xuất báo cáo:</b> <span id="reportDate"></span></div>
                </div>

                <div id="reportAlert" class="no-print"></div>

                <!-- TÓM TẮT ĐÁNH GIÁ -->
                <div class="stat-summary mb-3">
                    <div class="stat-box">
                        <div class="stat-number" id="sumTotal">--</div>
                        <div class="stat-label">Tổng số mẫu</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number text-success" id="sumPass">--</div>
                        <div class="stat-label">Đạt chuẩn</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number text-danger" id="sumFail">--</div>
                        <div class="stat-label">Vượt ngưỡng</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number" id="sumRate">--</div>
                        <div class="stat-label">Tỉ lệ đạt chuẩn</div>
                    </div>
                </div>

                <div class="alert alert-secondary" id="reportConclusion" style="font-size:14px;"></div>

                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle" style="font-size:13px;" id="reportTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ký hiệu mẫu</th>
                                        <th>Đợt</th>
                                        <th>Ngày</th>
                                        <th>pH</th>
                                        <th>DO</th>
                                        <th>BOD5</th>
                                        <th>COD</th>
                                        <th>TSS</th>
                                        <th>Coliform</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody id="reportTableBody">
                                    <tr>
                                        <td colspan="10" class="text-center text-muted py-4">Đang tải dữ liệu...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

</main>

<style>
    @media print {
        .no-print, header, footer, nav { display: none !important; }
        main { padding: 0 !important; }
        .col-lg-9 { width: 100% !important; max-width: 100% !important; flex: 0 0 100% !important; }
        #reportTable thead { display: table-header-group; }
        #reportTable tr { page-break-inside: avoid; }
        .card { box-shadow: none !important; border: 1px solid #ccc !important; }
    }
</style>

<!-- SheetJS để xuất Excel -->
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<%- include('partials/footer') %>
